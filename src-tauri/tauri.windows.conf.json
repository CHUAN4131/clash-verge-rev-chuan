{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Verge Route",
  "mainBinaryName": "verge-route",
  "identifier": "io.github.chuan4131.verge-route",
  "build": {
    "features": ["verge-route"]
  },
  "bundle": {
    "targets": ["nsis"],
    "icon": ["icons/verge-route/app.ico"],
    "resources": [
      "resources/ASN.mmdb",
      "resources/Country.mmdb",
      "resources/enableLoopback.exe",
      "resources/geoip.dat",
      "resources/geosite.dat",
      "resources/verge-route-service"
    ],
    "shortDescription": "Verge Route",
    "longDescription": "Verge Route",
    "publisher": "CHUAN4131",
    "createUpdaterArtifacts": false,
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "nsis": {
        "displayLanguageSelector": true,
        "installerIcon": "icons/verge-route/app.ico",
        "languages": ["SimpChinese", "English", "Russian"],
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": []
    },
    "deep-link": {
      "desktop": {
        "schemes": ["verge-route"]
      }
    }
  },
  "app": {
    "windows": [],
    "security": {
      "capabilities": [
        "desktop-capability",
        "desktop-windows-capability",
        "migrated"
      ]
    }
  }
}
